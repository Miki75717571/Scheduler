# Copy this file to .env at the repo root (used by docker-compose and by the
# backend, which reads ../.env relative to backend/). For running the frontend
# outside Docker, also copy frontend/.env.example to frontend/.env.

# --- Database ---
# One raw URL, no driver suffix needed (paste it exactly as your provider gives
# it, e.g. Supabase's plain `postgresql://...`) - the app derives an asyncpg
# URL from this for itself and a psycopg (sync) URL for Alembic; see
# backend/app/core/config.py. sslmode, if present, is handled for you.
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler
POSTGRES_DB=scheduler
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler
# Using `docker compose --profile local-db up` instead of a real Postgres/Supabase?
# Point this at the in-network service name instead of localhost:
# DATABASE_URL=postgresql://scheduler:scheduler@postgres:5432/scheduler
#
# Supabase Session pooler example (port 5432, IPv4):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Separate database pytest runs against so tests never touch dev data.
# Leave unset to fall back to DATABASE_URL - fine for CI (a throwaway DB), but
# if DATABASE_URL is Supabase, DO NOT leave this unset: the test suite runs
# `CREATE TABLE`/`DROP TABLE` on every session and would wipe your real
# users/invitations tables. Point it at a local Postgres or a disposable
# Supabase project instead.
# TEST_DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler_test

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_TOKEN_SECRET=change-me-invitation-secret
INVITATION_TOKEN_EXPIRE_HOURS=72

# --- Email ---
# "console" (default) logs invite emails instead of sending them - no account needed for dev.
# Set to "resend" and provide RESEND_API_KEY to actually send.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Cafeteria Scheduler <no-reply@example.com>"

# --- Bootstrap admin ---
# Created by `python -m app.seed` the first time there is no ADMIN user yet.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-admin-password
ADMIN_BOOTSTRAP_FULL_NAME="Cafeteria Owner"

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- App ---
APP_ENV=development
FRONTEND_BASE_URL=http://localhost:5173

# --- Frontend (Vite; must be prefixed VITE_) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

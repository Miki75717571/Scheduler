# Optional. The dev server proxies /api to the backend automatically
# (see vite.config.ts) and the app calls the API with relative paths, so this
# is unset by default - it works unmodified from localhost or from any device
# on your LAN. Only set this if the frontend and backend are ever deployed to
# different origins (e.g. a separately-hosted production frontend).
# VITE_API_BASE_URL=https://api.example.com/api/v1
